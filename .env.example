# FitLife settings. Every value has a local-development default, so nothing here is required except
# GEMINI_KEY for real AI recommendations (without it, recommendations are marked FALLBACK).
#
# docker compose reads this file as .env. The Spring services read the same names from the
# environment: export them in each terminal (bash) or set them with $env:NAME = "value" (PowerShell).

# --- AI service -------------------------------------------------------------
# Google AI Studio key. Never commit it, and never put it in an IDE run configuration that is tracked.
GEMINI_KEY=
# generateContent endpoint of the model to use
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
GEMINI_TIMEOUT=20s

# --- PostgreSQL (user service) ----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fitlife-local-dev
USER_DB_URL=jdbc:postgresql://localhost:5432/fitness-micro-user

# --- MongoDB (activity and AI services) -------------------------------------
ACTIVITY_MONGODB_URI=mongodb://localhost:27017/aiactivityfitness
AI_MONGODB_URI=mongodb://localhost:27017/airecommendationfitness

# --- Kafka ------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8181
# Admin console login (http://localhost:8181, user "admin")
KEYCLOAK_ADMIN_PASSWORD=admin
# Secret of the fitlife-backend client: compose puts it into the realm import, the gateway uses it
# to create users. Change it before the first `docker compose up` (the realm is imported once).
KEYCLOAK_ADMIN_CLIENT_SECRET=fitlife-local-dev-client-secret

# --- Service discovery and configuration ------------------------------------
EUREKA_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# --- Frontend (fitness-frontend/.env.local; Vite only reads VITE_*) -----------
# VITE_API_URL=http://localhost:8080/api
# VITE_KEYCLOAK_URL=http://localhost:8181
